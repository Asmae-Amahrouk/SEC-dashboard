# Weekly blog-ideas email for the Docker version.
# Copy this file to ".env" (never commit .env) and fill in your values.
# Brevo (free): SMTP_HOST=smtp-relay.brevo.com, SMTP_USERNAME = Brevo SMTP login, SMTP_PASSWORD = Brevo SMTP key.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PASSWORD = a Google "App password".
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password
EMAIL_TO=you@example.com
# Optional
EMAIL_FROM=
DASHBOARD_URL=http://localhost:8080/
